# The backend's production settings. Copy to /opt/mergio/backend.env on the server and
# `chmod 600` it. Never commit the real file.

NODE_ENV=production
PORT=4000
# Browser origins allowed to call the API.
CORS_ORIGIN="https://mergio.in,https://www.mergio.in"

# The same database the Vercel site uses. Use a direct or session-pooler URL, not a
# transaction pooler: this is a long-running process.
DATABASE_URL=""
# Optional: a direct connection for `prisma migrate` if DATABASE_URL goes through a pooler.
# DIRECT_URL=""

# The Mergio GitHub App (F-06), for the sync worker: the App ID and the private key PEM, on
# one line with \n for line breaks. Without them, GitHub sync jobs wait in the queue.
# (These are NOT the OAuth sign-in GITHUB_CLIENT_ID/SECRET, which only the web app uses.)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# The sync worker runs inside the API process.
RUN_WORKER="true"
WORKER_CONCURRENCY="4"

# Leaderboard cache (F-08): the same Upstash Redis as the Vercel site. Either the REST pair
# (as Vercel uses) or a TCP URL (rediss://default:<password>@<host>:6379).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# REDIS_URL=""
