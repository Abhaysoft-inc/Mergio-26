# Copy to deploy/.env on the server (git-ignored).
# The Docker network the reverse proxy is on; the backend joins it so the proxy can reach
# http://mergio-backend:4000. On the current VPS that is Nginx Proxy Manager's network.
PROXY_NETWORK=rexial_rexial-network
# Where the backend's secrets live (outside the repo, chmod 600).
MERGIO_ENV_FILE=/opt/mergio/backend.env
