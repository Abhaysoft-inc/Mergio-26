{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "export:registrations": "tsx --env-file-if-exists=.env src/scripts/export-registrations.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker-main.ts",
    "start:worker": "node --env-file-if-exists=.env dist/worker-main.js",
    "season:window": "tsx --env-file-if-exists=.env src/scripts/season-window.ts",
    "resync": "tsx --env-file-if-exists=.env src/scripts/resync.ts",
    "colleges:import": "tsx --env-file-if-exists=.env src/scripts/colleges-import.ts",
    "leaderboard:verify": "tsx --env-file-if-exists=.env src/scripts/leaderboard-verify.ts",
    "leaderboard:seed": "tsx --env-file-if-exists=.env src/scripts/leaderboard-seed.ts",
    "leaderboard:load": "tsx src/scripts/leaderboard-load.ts"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/scoring": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
