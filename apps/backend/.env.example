PORT=4000
CORS_ORIGIN="http://localhost:3001,http://localhost:3002"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mergio?schema=public"

# The Mergio GitHub App (F-06), used by the sync worker. The private key is the PEM file GitHub
# generates; put it on one line with \n for the line breaks. Without these, GitHub sync jobs
# wait in the queue until they are set.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# The sync worker runs inside the API process. Set RUN_WORKER=false to run it separately with
# `pnpm --filter backend worker` (or `start:worker` after a build).
RUN_WORKER="true"
WORKER_CONCURRENCY="4"

# Leaderboard cache (F-08). Upstash over TLS in production (rediss://default:<password>@<host>:6379),
# the docker-compose Redis locally.
REDIS_URL="redis://localhost:6380"
